# Pendulum environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Each container receives only the subset of variables it needs (see docker-compose files).

# --- App ---------------------------------------------------------------
APP_ENV=local                       # local | production
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC

# --- PostgreSQL --------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pendulum
POSTGRES_USER=pendulum
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ----------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Exchange ----------------------------------------------------------
# Active exchange adapter id (registered in ExchangeRegistry). Stage 1: bybit.
EXCHANGE_ACTIVE=bybit
# Stage 1: READ-ONLY key. Stage 2: spot trading only, NO withdrawal, IP-whitelisted.
EXCHANGE_BYBIT_API_KEY=your-bybit-api-key
EXCHANGE_BYBIT_API_SECRET=your-bybit-api-secret
EXCHANGE_BYBIT_TESTNET=false
# Fee schedule (fractions). Verify against your account tier.
EXCHANGE_BYBIT_MAKER_FEE=0.001
EXCHANGE_BYBIT_TAKER_FEE=0.001

# --- Grid defaults (per-pair overrides in config/pairs.toml) -----------
GRID_DEFAULT_TYPE=geometric         # geometric | arithmetic
GRID_DEFAULT_LEVELS=20
GRID_MIN_STEP_FEE_MULTIPLIER=1.5    # step must exceed round-trip fees x this
GRID_QUOTE_ASSET=USDT

# --- Pair scanner -------------------------------------------------------
SCANNER_MIN_24H_VOLUME_USD=5000000

# --- Risk (enforced live from Stage 2) ---------------------------------
RISK_MAX_TOTAL_CAPITAL_USD=500
RISK_MAX_PAIR_CAPITAL_PCT=30
RISK_DAILY_LOSS_LIMIT_PCT=5
RISK_MAX_OPEN_ORDERS=100

# --- Backtest -----------------------------------------------------------
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_DEFAULT_TIMEFRAME=1m

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Admin dashboard (Stage 3) -----------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=bcrypt-hash-here
