# Pendulum environment template. Copy to `.env` and fill in. NEVER commit `.env`.
# Each container receives only the subset of variables it needs (see docker-compose files).

# --- App ---------------------------------------------------------------
APP_ENV=local                       # local | production
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true
APP_TIMEZONE=UTC

# --- PostgreSQL --------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pendulum
POSTGRES_USER=pendulum
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ----------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Exchange ----------------------------------------------------------
# Active exchange adapter id (registered in ExchangeRegistry).
EXCHANGE_ACTIVE=bybit
# Optional READ-ONLY key: only used to fetch your account's real fee tier. Public market data needs no key.
EXCHANGE_BYBIT_API_KEY=
EXCHANGE_BYBIT_API_SECRET=
EXCHANGE_BYBIT_TESTNET=false
# Fee schedule (fractions) used when no key is configured.
EXCHANGE_BYBIT_MAKER_FEE=0.001
EXCHANGE_BYBIT_TAKER_FEE=0.001

# --- Grid defaults (per-pair overrides in config/pairs.toml) -----------
GRID_DEFAULT_TYPE=geometric         # geometric | arithmetic
GRID_DEFAULT_LEVELS=20
GRID_DEFAULT_WIDTH_PCT=16
GRID_DEFAULT_EXIT_POLICY=stop_loss+trailing_up
GRID_MIN_STEP_FEE_MULTIPLIER=1.5    # step must exceed round-trip fees x this
GRID_QUOTE_ASSET=USDT
GRID_PAIRS_FILE=config/pairs.toml

# --- Pair scanner -------------------------------------------------------
SCANNER_MIN_24H_VOLUME_USD=5000000
SCANNER_MAX_SPREAD_BPS=10
SCANNER_LOOKBACK_DAYS=30
SCANNER_TOP_N=15

# --- Simulated capital ---------------------------------------------------
CAPITAL_TOTAL_USD=500
CAPITAL_PAIR_PCT=30                 # default per-pair capital = total x pct

# --- Backtest -----------------------------------------------------------
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_DEFAULT_TIMEFRAME=1m

# --- Telegram (optional) -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
